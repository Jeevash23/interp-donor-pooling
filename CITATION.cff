    given-names: Richard
    orcid: "https://orcid.org/0009-0005-7812-0939"
version: 1.1.0
license: MIT
repository-code: "https://github.com/Jeevash23/interp-donor-pooling"
keywords:
  - mechanistic interpretability
  - activation patching
  - mean ablation
  - resample ablation
  - GPT-2
  - Qwen3
